# Fastfile for 360 Động từ bất quy tắc (iOS)
default_platform(:ios)

platform :ios do
  before_all do
    env_file = File.expand_path(".env", __dir__)
    if File.exist?(env_file)
      File.readlines(env_file).each do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#")
        key, value = line.split("=", 2)
        ENV[key] = value if key && value && ENV[key].nil?
      end
    end

    key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_filepath = ENV["APP_STORE_CONNECT_KEY_FILEPATH"] ? File.expand_path(ENV["APP_STORE_CONNECT_KEY_FILEPATH"], __dir__) : nil

    if key_id && issuer_id && key_filepath && File.exist?(key_filepath)
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: key_filepath,
        in_house: false
      )
    end
  end

  desc "Download Development Provisioning Profile"
  lane :dev_profile do
    get_provisioning_profile(
      app_identifier: "vn.phuongdan.360verb",
      team_id: "74Z46TRFH2",
      development: true,
      force: true
    )
  end

  desc "Deliver App Store Metadata only without binary upload"
  lane :metadata do
    deliver(
      app_identifier: "vn.phuongdan.360verb",
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Upload existing built IPA to TestFlight / App Store"
  lane :upload_ipa do
    upload_to_testflight(
      app_identifier: "vn.phuongdan.360verb",
      ipa: "../build/ios/ipa/app.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build & Upload Beta to TestFlight"
  lane :beta do
    get_provisioning_profile(
      app_identifier: "vn.phuongdan.360verb",
      team_id: "74Z46TRFH2",
      type: "app-store"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload Release IPA and Metadata to App Store"
  lane :release do
    get_provisioning_profile(
      app_identifier: "vn.phuongdan.360verb",
      team_id: "74Z46TRFH2",
      type: "app-store"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )
    deliver(
      metadata_path: "./metadata",
      skip_screenshots: true,
      force: true
    )
  end
end
